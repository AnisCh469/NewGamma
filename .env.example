# ============================================================================
# .env.example - Modèle de configuration pour docker-compose.prod.yml
# ============================================================================
# Copiez ce fichier en ".env" (même dossier) et renseignez de VRAIES valeurs
# avant tout déploiement en production. Le fichier ".env" ne doit JAMAIS être
# commité dans Git (il est listé dans .gitignore) : il contient des secrets.
#
# Comment générer une valeur forte :
#   - Mot de passe : openssl rand -base64 24
#   - Clé JWT (256 bits) : openssl rand -hex 32
# ============================================================================

# --- Base de données PostgreSQL ---
POSTGRES_DB=gamma3
POSTGRES_USER=gamma_admin
POSTGRES_PASSWORD=change-me-strong-password

# --- Sécurité applicative (backend) ---
# Clé secrète utilisée pour signer les jetons JWT. Doit être longue, aléatoire,
# et différente entre chaque environnement (dev/test/prod).
JWT_SECRET_KEY=change-me-64-hex-characters-minimum

# Compte administrateur créé automatiquement au premier démarrage si la base
# est vide (voir gamma3-backend/.../config/DataSeeder.java).
ADMIN_MATRICULE=admin
ADMIN_PASSWORD=change-me-strong-password
